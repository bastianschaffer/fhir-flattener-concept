{
  "resourceType": "https://sql-on-fhir.org/ig/StructureDefinition/ViewDefinition",
  "name": "condition-test",
  "status": "draft",
  "resource": "Condition",
  "select": [
    {
      "column": [
        {
          "name": "id",
          "path": "getResourceKey()"
        }
      ]
    },
    {
      "forEach": "stage",
      "select": [
        {
          "forEach": "summary.coding",
          "select": [
            {
              "column": [
                {
                  "name": "codesystem",
                  "path": "system"
                },
                {
                  "name": "summarycode",
                  "path": "code"
                }
              ]
            }
          ]
        },
        {
          "forEach": "type.coding",
          "select": [
            {
              "column": [
                {
                  "name": "codesystem1",
                  "path": "system"
                },
                {
                  "name": "typecode",
                  "path": "code"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}